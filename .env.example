# Local Docker Postgres (docker compose up -d). Never point these at Neon.
DATABASE_URL=postgres://laozi:laozi@localhost:5442/laozi
DATABASE_URL_UNPOOLED=postgres://laozi:laozi@localhost:5442/laozi
# Used by the database integrity tests (created by compose on first start)
TEST_DATABASE_URL=postgres://laozi:laozi@localhost:5442/laozi_test

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The single account, created by the seed if it doesn't exist yet
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
